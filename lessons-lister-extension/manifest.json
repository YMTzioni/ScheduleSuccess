{
  "manifest_version": 3,
  "name": "Lessons Lister",
  "description": "סורק את כל המסלולים, הקורסים והשיעורים באתר ומייצר רשימת שיעורים מסוננת עם דוח בדיקה.",
  "version": "0.2.0",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": ["https://login.successcollege.co.il/*"],
  "action": {
    "default_title": "Lessons Lister",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
